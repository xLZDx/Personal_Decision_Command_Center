{
  "name": "personal-decision-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Personal work, knowledge and decision operating layer over Gmail + personal Telegram",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "connectors/*",
    "host/*",
    "apps/*"
  ],
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test",
    "verify:mutation": "node scripts/verify/mutation-check.mjs",
    "verify:secrets": "node scripts/verify/check-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
